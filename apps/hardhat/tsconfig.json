{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@saas-monorepo/typescript-config/base.json",
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  }
}
