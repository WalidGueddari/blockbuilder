generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(cuid())
  email      String     @unique
  password   String     @db.Text()
  create_at  DateTime   @default(now())
  updated_at DateTime   @default(now()) @updatedAt
  network    Network[]
  vmServers  VmServer[]

  @@index([email])
  @@map("users")
}

model Network {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("QBFT")
  status    Status   @default(PENDING)
  nodeCount Int
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  server    VmServer @relation(fields: [serverId], references: [id])
  serverId  String
  nodes     Node[]

  create_at  DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

model Node {
  id          String  @id @default(cuid())
  networkId   String
  name        String
  container   String
  status      Status  @default(ACTIVE)
  network     Network @relation(fields: [networkId], references: [id])
  p2pPort     Int
  rpcHttpPort Int
  rpcWsPort   Int
  p2pHost     String
  rpcHttpHost String
  rpcWsHost   String
  wsHost      String
  nodeIp      String
  enodeUrl    String
  isBootnode  Boolean @default(false)

  create_at  DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

model VmServer {
  id               String   @id @default(cuid())
  azureId          String // The unique identifier of the VM in Azure
  adminUsername    String // The admin username for the VM
  vmName           String // The name of the VM
  location         String // Azure region where the VM is deployed
  macAddress       String // MAC address of the VM's network interface
  powerState       String // Current power state of the VM (e.g., "VM running")
  privateIpAddress String // The private IP address assigned to the VM
  publicIpAddress  String // The public IP address assigned to the VM
  resourceGroup    String // The Azure resource group for the VM
  sshKeyName       String // The SSH key name used to authenticate with the VM
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  network Network[]
  user    User      @relation(fields: [userId], references: [id])
  userId  String
}

enum Status {
  PENDING
  ACTIVE
  FAILED
  INACTIVE
}
