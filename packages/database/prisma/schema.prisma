generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  password   String    @db.Text()
  create_at  DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt
  network    Network[]

  @@index([email])
  @@map("users")
}

model Network {
  id        String @id @default(cuid())
  name      String
  type      String @default("QBFT")
  status    Status @default(PENDING)
  nodeCount Int
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  nodes     Node[]

  create_at  DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

model Node {
  id          String  @id @default(cuid())
  networkId   String
  name        String
  container   String
  status      Status  @default(ACTIVE)
  network     Network @relation(fields: [networkId], references: [id])
  p2pPort     Int
  rpcHttpPort Int
  rpcWsPort   Int
  p2pHost     String
  rpcHttpHost String
  rpcWsHost   String
  wsHost      String
  nodeIp      String
  enodeUrl    String
  isBootnode  Boolean @default(false)

  create_at  DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

enum Status {
  PENDING
  ACTIVE
  FAILED
  INACTIVE
}
