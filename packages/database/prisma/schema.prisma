generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  password   String     @db.Text()
  role       UserRole   @default(USER)
  isActive   Boolean    @default(false)
  code       String?    @unique
  create_at  DateTime   @default(now())
  updated_at DateTime   @default(now()) @updatedAt
  network    Network[]
  vmServers  VmServer[]
  Job        Job[]

  @@index([email])
}

model Network {
  id                 String             @id @default(cuid())
  name               String
  type               String             @default("QBFT")
  status             Status             @default(PENDING)
  nodeCount          Int
  userId             String
  chainId            Int                @default(1337)
  user               User               @relation(fields: [userId], references: [id])
  server             VmServer?          @relation(fields: [serverId], references: [id])
  serverId           String?
  nodes              Node[]
  genesis            Genesis?
  allocs             Alloc[]
  blockscoutServer   VmServer?          @relation("BlockscoutServer", fields: [blockscoutServerId], references: [id])
  blockscoutServerId String?
  deployedContracts  DeployedContract[]
  create_at          DateTime           @default(now())
  updated_at         DateTime           @default(now()) @updatedAt
  Job                Job[]
}

model Genesis {
  id        String  @id @default(cuid())
  network   Network @relation(fields: [networkId], references: [id]) // Define fields & references here
  networkId String  @unique // Foreign key to Network

  berlinBlock    Int @default(0)
  blockPeriod    Int @default(2)
  epochLength    Int @default(30000)
  requestTimeout Int @default(4)

  nonce      String @default("0x0")
  timestamp  String
  gasLimit   String
  difficulty String
  mixHash    String
  coinbase   String @default("0x0000000000000000000000000000000000000000")

  create_at DateTime @default(now())
}

model Alloc {
  id             String  @id @default(cuid())
  public_address String
  private_key    String
  balance        String
  networkId      String
  network        Network @relation(fields: [networkId], references: [id])

  create_at  DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

model Node {
  id          String  @id @default(cuid())
  networkId   String
  name        String
  container   String
  status      Status  @default(PENDING)
  network     Network @relation(fields: [networkId], references: [id])
  p2pPort     Int
  rpcHttpPort Int
  rpcWsPort   Int
  p2pHost     String
  rpcHttpHost String
  rpcWsHost   String
  wsHost      String
  nodeIp      String
  enodeUrl    String
  isBootnode  Boolean @default(false)

  create_at  DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

model VmServer {
  id               String   @id @default(cuid())
  azureId          String
  adminUsername    String
  vmName           String
  location         String
  macAddress       String
  powerState       String
  privateIpAddress String
  publicIpAddress  String
  resourceGroup    String
  sshKeyName       String
  dnsName          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  network            Network[]
  blockscoutNetworks Network[] @relation("BlockscoutServer")
  user               User      @relation(fields: [userId], references: [id])
  userId             String
}

model Job {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  status       String
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Network      Network? @relation(fields: [networkId], references: [id])
  networkId    String?
}

enum Status {
  PENDING
  ACTIVE
  FAILED
  INACTIVE
}

enum UserRole {
  USER
  ADMIN
  DEMO
}

// Add new models for contract management
model DeployedContract {
  id              String                @id @default(cuid())
  address         String                @unique
  name            String
  type            String
  description     String?
  tags            String[]
  abi             Json? // Store ABI as JSON
  transactionHash String // ✅ Add this line
  deployedAt      DateTime              @default(now())
  networkId       String
  network         Network               @relation(fields: [networkId], references: [id])
  interactions    ContractInteraction[]
  favorites       FavoriteContract[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model DraftContract {
  id          String   @id @default(cuid())
  name        String
  type        String? // Corresponds to ContractConfig.contractType
  content     String   @db.Text // Solidity code or main content
  description String?
  tags        String[]
  networkId   String? // Optional: if the draft is associated with a specific network context
  config      Json? // Added: To store the ContractConfig object
  isFavorite  Boolean  @default(false) // Added: To track favorite status

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContractInteraction {
  id           String           @id @default(cuid())
  contractId   String
  contract     DeployedContract @relation(fields: [contractId], references: [id])
  functionName String
  args         String[]
  result       Json?
  status       String // 'success' or 'error'
  error        String?
  createdAt    DateTime         @default(now())
}


